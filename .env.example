PORT=5051
NODE_ENV=development
JWT_SECRET=your-secret-key-here

# ── Database Seeding ────────────────────────────────────
# Set to 'true' to automatically seed database on app startup
# Set to 'false' to prevent automatic data restoration after deletion
ENABLE_SEED=false

# ── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/dbname?retryWrites=true&w=majority

# Redis is optional for local development. Leave this disabled to run without Redis.
USE_REDIS=false
USE_MEMORY_DB=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── Files / Storage Configuration ────────────────────────
# Choose one storage provider: local, s3, or supabase

# Local Storage (Default - files stored on server)
# STORAGE_PROVIDER=local
# UPLOADS_DIR=./uploads
# CDN_URL=http://localhost:5051/uploads

# ────────────────────────────────────────────────────────
# S3 Compatible Storage (AWS S3, MinIO, Zata Cloud, etc.)
# ────────────────────────────────────────────────────────
# STORAGE_PROVIDER=s3
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=false
# CDN_URL=https://your-bucket-name.s3.amazonaws.com

# ────────────────────────────────────────────────────────
# Supabase Storage (Recommended for quick setup)
# ────────────────────────────────────────────────────────
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (anon public key)
# SUPABASE_BUCKET=media
# SUPABASE_CDN_URL=https://your-project-id.supabase.co/storage/v1/object/public/media

# ── Brevo (Sendinblue) Email Provider ───────────────────
# FEATURE_EMAIL_PROVIDER_BREVO=true
# BREVO_API_KEY=xkeysib-xxxxx
# BREVO_SENDER_EMAIL=noreply@example.com
# BREVO_SENDER_NAME=Vishwasai Consultancy

# ── Webhook Auto-Deployment Settings ───────────────────
# DEPLOY_WEBHOOK_SECRET=your-webhook-secret

# ── Deployment Commands (Customize to your environment) ──
# DEPLOY_COMMAND_DEV=pm2 start ecosystem.config.js --env development
# DEPLOY_COMMAND_PROD=pm2 start ecosystem.config.js --env production
